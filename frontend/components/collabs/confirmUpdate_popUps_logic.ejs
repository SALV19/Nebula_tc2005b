<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    const successDataUpdate = <%- JSON.stringify(successDataUpdate || null) %>;

    if (successDataUpdate) {
        Swal.fire({
            title: "¡Updated Colaborator!",
            html: `
                <p><b>Name:</b> ${successDataUpdate.nombre} ${successDataUpdate.apellidos}</p>
                <p><b>email:</b> ${successDataUpdate.email}</p>
                <p><b>Phone:</b> ${successDataUpdate.telefono}</p>
                <p><b>RFC:</b> ${successDataUpdate.rfc}</p>
                <p><b>CURP:</b> ${successDataUpdate.curp}</p>
                <p><b>Position:</b> ${successDataUpdate.puesto}</p>
                <p><b>Location:</b> ${successDataUpdate.ubicacion}</p>
                <p><b>Modality:</b> ${successDataUpdate.modalidad}</p>
                <p><b>Role:</b> ${successDataUpdate.rol}</p>
                <p><b>Entry Date:</b> ${successDataUpdate.entryDate}</p>
                <p><b>Birthdate:</b> ${successDataUpdate.birthday}</p>
            `,
            icon: "success",
            confirmButtonText: "OK",
        }).then(() => {
            window.history.replaceState({}, document.title, window.location.pathname);
        });
    }
});
</script>
