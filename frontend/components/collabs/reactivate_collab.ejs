<script>
    function reactivate_button(id_colaborador) {
        Swal.fire({
            title: 'Are you sure?',
            text: "This action will reactivate the collaborator. Do you want to continue?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, reactivate it',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                const csrf = document.getElementById('_csrf').value;

                fetch('/view_collabs/reactivateCollab', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'csrf-token': csrf
                    },
                    body: JSON.stringify({ colab_reactivate: id_colaborador }),
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Toast.fire({
                            icon: 'success',
                            title: 'Collaborator deleted successfully'
                        });

                        const rowToRemove = document.querySelector(`[onclick="reactivate_button('${id_colaborador}')"]`).closest('tr');
                        if (rowToRemove) {
                            fadeOut(rowToRemove, () => {
                                get_info();
                            });
                        }
                    } else {
                        Toast.fire({
                            icon: 'error',
                            title: data.error || 'Error reactivating collaborator'
                        });
                    }
                })
                .catch(error => {
                    console.error('Error in request:', error);
                    Toast.fire({
                        icon: 'error',
                        title: 'Server error'
                    });
                });
            }
        })
    }
    function fadeOut(element, callback) {
        let opacity = 1;
        const interval = setInterval(() => {
            opacity -= 0.1;
            element.style.opacity = opacity;
            if (opacity <= 0) {
                clearInterval(interval);
                element.style.display = 'none';
                if (callback) {
                    callback();
                }
            }
        }, 50);
    }
</script>