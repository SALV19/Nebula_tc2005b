<link rel="stylesheet" href="/css/manual.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma-carousel@4.0.4/dist/css/bulma-carousel.min.css">
<script src="https://cdn.jsdelivr.net/npm/bulma-carousel@4.0.4/dist/js/bulma-carousel.min.js"></script>

<script>
    let carouselInstance = null;

    const manuals = {
        "/": [
            {
                html: `
            </div><p class="scribe-screenshot-container"><img class="scribe-screenshot" width="560" alt="" src="https://ajeuwbhvhr.cloudimg.io/colony-recorder.s3.amazonaws.com/files/2025-04-22/519d80be-0e64-47c0-a4f6-4633d4392b1f/ascreenshot.jpeg?tl_px=0,174&br_px=2122,1361&force_format=jpeg&q=100&width=1120.0&wat=1&wat_opacity=0.7&wat_gravity=northwest&wat_url=https://colony-recorder.s3.us-west-1.amazonaws.com/images/watermarks/FB923C_standard.png&wat_pad=548,277"/></p><div class="scribe-step"><p class="scribe-step-text">3. Click this button.</p>
                `
            },
            {
                img: "https://ajeuwbhvhr.cloudimg.io/colony-recorder.s3.amazonaws.com/files/2025-04-21/9c8b6175-75a6-4777-bdf1-e84847388583/ascreenshot.jpeg",
                text: "2. Haz clic aquí"
            },
            {
                img: "https://ajeuwbhvhr.cloudimg.io/colony-recorder.s3.amazonaws.com/files/2025-04-21/4a96eb28-8399-477a-9567-23c6677978ea/ascreenshot.jpeg",
                text: "3. Luego selecciona el ícono"
            }
        ],
        "/requests": [
            {
                img: "https://ajeuwbhvhr.cloudimg.io/colony-recorder.s3.amazonaws.com/files/2025-04-21/9c8b6175-75a6-4777-bdf1-e84847388583/ascreenshot.jpeg",
                text: "2. Haz clic aquí"
            },
            {
                img: "https://ajeuwbhvhr.cloudimg.io/colony-recorder.s3.amazonaws.com/files/2025-04-21/4a96eb28-8399-477a-9567-23c6677978ea/ascreenshot.jpeg",
                text: "3. Luego selecciona el ícono"
            }
        ]
    };

    function openManual() {
        const popup = document.getElementById("pop-upM");
        const wrapper = document.getElementById("slider-wrapper");
        const path = window.location.pathname;

        

        wrapper.innerHTML = "";

        const steps = manuals[path] || [];

        if (steps.length === 0) {
            wrapper.innerHTML = "<p style='color: white;'>No hay pasos disponibles para esta ruta.</p>";
        } else {
            const slider = document.createElement("div");
            const uniqueId = `slider-${Date.now()}`;
            slider.id = uniqueId;
            slider.className = "carousel";

            steps.forEach((step) => {
                const item = document.createElement("div");
                item.className = "carousel-item";
                item.innerHTML = step.html || `
                    <div class="card">
                        <div class="card-image">
                            <figure class="image is-16by9">
                                <img src="${step.img}" alt="Paso" />
                            </figure>
                        </div>
                        <div class="card-content">
                            <p class="scribe-step-text">${step.text}</p>
                        </div>
                    </div>
                `;
                slider.appendChild(item);
            });

            wrapper.appendChild(slider);

            popup.style.display = "flex";

            setTimeout(() => {
                const instances = bulmaCarousel.attach(`#${uniqueId}`, {
                    
                    slidesToScroll: 1,
                    slidesToShow: 1,
                    infinite: false,
                    autoplay: false,
                    navigation: true,
                    pagination: true
                });
                
                console.log('Se intentó inicializar el carrusel con ID:', uniqueId);



                if (instances.length > 0) {
                    carouselInstance = instances[0];
                }
            }, 50); 
        }
    }

    function closePopupM() {
        const popup = document.getElementById("pop-upM");
        popup.style.display = "none";

      

        const wrapper = document.getElementById("slider-wrapper");
        wrapper.innerHTML = "";
    }

    window.openManual = openManual;
    window.closePopupM = closePopupM;

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelector('.bi-question-circle')?.addEventListener('click', openManual);
    });

</script>