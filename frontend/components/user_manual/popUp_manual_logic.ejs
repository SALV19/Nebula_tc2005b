<script src="https://cdn.jsdelivr.net/npm/bulma-carousel@4.0.4/dist/js/bulma-carousel.min.js"></script>
<script>
    let carouselInstance = {};

    function openManualByRoute() {
    const route = window.location.pathname;

    if (route === '/') {
        openManual('pop-upCalendar', 'slider1');
    } else if (route === '/manual/notion') {
        openManual('pop-upRequest', 'slider2');
    }
}

    function openManual() {
        const popup = document.getElementById("popupId");
        if (popup) {
            popup.style.display = "flex";

            setTimeout(() => {
                if (!carouselInstance) {
                    carouselInstance = bulmaCarousel.attach('#slider', {
                        slidesToScroll: 1,
                        slidesToShow: 1,
                        infinite: false,
                        autoplay: false,
                        navigation: true,
                        pagination: true
                    })[0]; 
                }
            }, 100); 
        }
    }

    function closePopupM() {
        const popup = document.getElementById("pop-upM");
        if (popup) {
            popup.style.display = "none";
        }

        if (carouselInstance) {
            carouselInstance.reset();
        }
    }

    document.addEventListener('DOMContentLoaded', openManualByRoute);

</script>